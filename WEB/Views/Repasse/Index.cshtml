@using DOMAIN.Model.Repasse
@model ResumoRepasseModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Repasses";
    ViewData["ActivePage"] = "Repasse";
    ViewData["PageTitle"] = "Repasses";
    ViewData["PageSubtitle"] = "Acompanhe o que você tem a receber das vendas pagas online";

    var cultura = new System.Globalization.CultureInfo("pt-BR");
    var abertos = Model.Fechamentos.Where(f => f.Situacao == "aberto").Sum(f => f.ValorARepassar);
    var fechados = Model.Fechamentos.Where(f => f.Situacao == "fechado").Sum(f => f.ValorARepassar);
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="stat-card success">
            <div class="stat-label"><i class="fas fa-wallet"></i> Total a receber</div>
            <div class="stat-value">@Model.TotalARepassar.ToString("C2", cultura)</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="stat-card warning">
            <div class="stat-label"><i class="fas fa-hourglass-half"></i> Semana em andamento</div>
            <div class="stat-value">@abertos.ToString("C2", cultura)</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="stat-card info">
            <div class="stat-label"><i class="fas fa-lock"></i> Semanas fechadas</div>
            <div class="stat-value">@fechados.ToString("C2", cultura)</div>
        </div>
    </div>
</div>

<p class="text-muted" style="font-size:13px;">
    Entram nos repasses os pedidos pagos online e finalizados. O IValid retém @Model.ComissaoPercentual.ToString("0.##", cultura)% de comissão sobre cada pedido.
    O fechamento é semanal (segunda a domingo) e o pagamento é previsto para a quarta-feira seguinte.
</p>

@if (Model.Fechamentos.Count == 0)
{
    <div class="admin-card">
        <div class="text-center py-5">
            <i class="fas fa-wallet" style="font-size:48px; color:#ddd;"></i>
            <p class="mt-3" style="color:#aaa; font-size:14px;">Nenhum repasse ainda. Os pedidos pagos online aparecem aqui quando são finalizados.</p>
        </div>
    </div>
}
else
{
    @foreach (var (fechamento, indice) in Model.Fechamentos.Select((f, i) => (f, i)))
    {
        var idDetalhe = $"detalhe-{indice}";
        var aberto = fechamento.Situacao == "aberto";

        <div class="admin-card mb-3">
            <div class="admin-card-header">
                <div>
                    <h2 class="admin-card-title">
                        <i class="fas fa-calendar-week me-2" style="color:var(--azul)"></i>@fechamento.InicioSemana.ToString("dd/MM") a @fechamento.FimSemana.ToString("dd/MM/yyyy")
                    </h2>
                    <div style="font-size:12px;color:#aaa;margin-top:4px;">
                        @(aberto ? "Semana em andamento" : "Fechada")
                        &middot; Pagamento previsto em @fechamento.DataPrevistaPagamento.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="@(aberto ? "badge-amarelo" : "badge-verde")">@(aberto ? "ABERTA" : "FECHADA")</span>
                    <div style="text-align:right;">
                        <div style="font-size:11px;color:#aaa;">A receber</div>
                        <div style="font-weight:700;color:var(--verde);font-size:18px;">@fechamento.ValorARepassar.ToString("C2", cultura)</div>
                    </div>
                    <button class="filtro-status" type="button" data-bs-toggle="collapse" data-bs-target="#@idDetalhe" aria-expanded="false" aria-controls="@idDetalhe">
                        <i class="fas fa-list me-1"></i> @fechamento.QuantidadePedidos pedido(s)
                    </button>
                </div>
            </div>

            <div class="collapse" id="@idDetalhe">
                <div class="px-4 py-2" style="font-size:12px;color:#555;border-bottom:1px solid #eef0f4;">
                    Vendas brutas: <strong>@fechamento.VendasBrutas.ToString("C2", cultura)</strong>
                    &middot; Comissão: <strong>@fechamento.Comissao.ToString("C2", cultura)</strong>
                </div>
                <div class="table-responsive">
                    <table class="table admin-table mb-0">
                        <thead>
                            <tr>
                                <th>Pedido</th>
                                <th>Data</th>
                                <th>Total</th>
                                <th>Comissão</th>
                                <th>Líquido</th>
                                <th style="text-align:center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in fechamento.Pedidos)
                            {
                                <tr>
                                    <td style="font-size:12px;">@(pedido.PedidoId?.Length > 8 ? pedido.PedidoId[..8] + "..." : pedido.PedidoId)</td>
                                    <td>@pedido.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@pedido.Total.ToString("C2", cultura)</td>
                                    <td style="color:var(--vermelho);">- @pedido.Comissao.ToString("C2", cultura)</td>
                                    <td style="font-weight:700;color:var(--verde);">@pedido.Liquido.ToString("C2", cultura)</td>
                                    <td>
                                        <div class="d-flex gap-1 justify-content-center">
                                            <a asp-controller="Pedido" asp-action="Details" asp-route-id="@pedido.PedidoId" class="btn-icon view" title="Ver pedido">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
