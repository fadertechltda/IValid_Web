@model DOMAIN.Model.Usuario.EsqueciSenhaModel
@{
    Layout = null;
    ViewData["Title"] = "Esqueci minha senha";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IValid Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --vermelho: #E53935;
            --vermelho-dark: #B71C1C;
            --vermelho-light: #FFEBEE;
            --amarelo: #F9A825;
            --verde: #2E7D32;
            --sidebar-bg: #1a1a2e;
            --text-muted-custom: #8a8fa3;
            --bg-page: #f4f6fb;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .login-container {
            width: 100%;
            max-width: 460px;
            background: white;
            border-radius: 10px;
            border: 1px solid #eef0f4;
            padding: 50px;
        }

        .brand-logo-large {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            background: var(--vermelho);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 26px;
            color: white;
            margin-bottom: 24px;
        }

        .login-title {
            font-size: 24px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 8px;
        }

        .login-subtitle {
            font-size: 14px;
            color: var(--text-muted-custom);
            margin-bottom: 30px;
        }

        .form-label-custom {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .form-control-custom {
            border: 1.5px solid #e8eaef;
            border-radius: 6px;
            font-size: 15px;
            padding: 12px 16px;
            transition: all 0.2s;
            color: #333;
            background-color: #fcfcfd;
            margin-bottom: 20px;
        }

        .form-control-custom:focus {
            border-color: var(--vermelho);
            box-shadow: 0 0 0 4px rgba(229,57,53,0.1);
            outline: none;
            background-color: white;
        }

        .btn-login {
            background: var(--vermelho);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            padding: 14px;
            font-size: 15px;
            width: 100%;
            transition: background 0.15s;
        }

        .btn-login:hover {
            background: var(--vermelho-dark);
        }

        .alert-custom {
            border-radius: 6px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--vermelho-light);
            color: var(--vermelho-dark);
            margin-bottom: 24px;
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            font-size: 14px;
            color: var(--text-muted-custom);
            text-decoration: none;
            font-weight: 500;
        }

        .back-link:hover {
            color: var(--vermelho);
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand-logo-large">I</div>
        <h2 class="login-title">Esqueceu a senha?</h2>
        <p class="login-subtitle">Informe seu email de administrador e enviaremos um link para redefinir sua senha.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-custom">
                <i class="fas fa-exclamation-circle fs-5"></i>
                <div>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled p-0 m-0" })
                </div>
            </div>
        }

        <form asp-controller="Autenticacao" asp-action="EsqueciSenha" method="post">
            <div>
                <label asp-for="Email" class="form-label-custom">Email</label>
                <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="exemplo@ivalid.com" required autocomplete="username" />
            </div>

            <button type="submit" class="btn-login">
                Enviar link de redefinição <i class="fas fa-paper-plane ms-2"></i>
            </button>
        </form>

        <a asp-controller="Autenticacao" asp-action="Login" class="back-link">
            <i class="fas fa-arrow-left me-1"></i> Voltar para o login
        </a>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var alertas = document.querySelectorAll('.alert-custom, .alert-sucesso');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    alerta.style.transition = 'opacity 0.4s ease';
                    alerta.style.opacity = '0';
                    setTimeout(function () {
                        alerta.remove();
                    }, 400);
                }, 4000);
            });
        });
    </script>
</body>
</html>
