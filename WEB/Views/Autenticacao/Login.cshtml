@using DOMAIN.Model.Usuario
@model LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Entrar";
    var usuarios = ViewData["Usuarios"] as List<UsuarioLoginModel> ?? [];
    var lojaSelecionada = ViewData["LojaSelecionada"] != null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IValid Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --vermelho: #E53935;
            --vermelho-dark: #B71C1C;
            --vermelho-light: #FFEBEE;
            --amarelo: #F9A825;
            --verde: #2E7D32;
            --sidebar-bg: #1a1a2e;
            --text-muted-custom: #8a8fa3;
            --bg-page: #f4f6fb;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-container {
            width: 100%;
            max-width: 1000px;
            background: white;
            border-radius: 10px;
            border: 1px solid #eef0f4;
            display: flex;
            overflow: hidden;
            margin: 20px;
        }

        .login-image-section {
            flex: 1.2;
            background: var(--sidebar-bg);
            padding: 60px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: white;
            position: relative;
        }

        .brand-logo-large {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            background: var(--vermelho);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 26px;
            color: white;
            margin-bottom: 30px;
            position: relative;
            z-index: 2;
        }

        .hero-title {
            font-size: 36px;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }
        
        .hero-title span {
            color: var(--vermelho);
        }

        .hero-subtitle {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
            position: relative;
            z-index: 2;
        }

        .login-form-section {
            flex: 1;
            padding: 60px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-header {
            margin-bottom: 40px;
        }

        .login-title {
            font-size: 28px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 8px;
        }

        .login-subtitle {
            font-size: 14px;
            color: var(--text-muted-custom);
        }

        .form-label-custom {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .form-control-custom {
            border: 1.5px solid #e8eaef;
            border-radius: 6px;
            font-size: 15px;
            padding: 12px 16px;
            transition: all 0.2s;
            color: #333;
            background-color: #fcfcfd;
            margin-bottom: 20px;
        }

        .form-control-custom:focus {
            border-color: var(--vermelho);
            box-shadow: 0 0 0 4px rgba(229,57,53,0.1);
            outline: none;
            background-color: white;
        }

        .btn-login {
            background: var(--vermelho);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            padding: 14px;
            font-size: 15px;
            width: 100%;
            transition: background 0.15s;
            margin-top: 10px;
        }

        .btn-login:hover {
            background: var(--vermelho-dark);
        }

        .alert-custom {
            border-radius: 6px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--vermelho-light);
            color: var(--vermelho-dark);
            margin-bottom: 24px;
        }

        .alert-sucesso {
            border-radius: 6px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #E8F5E9;
            color: var(--verde);
            margin-bottom: 24px;
        }

        .forgot-password {
            font-size: 13px;
            color: var(--text-muted-custom);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
            float: right;
            margin-top: -12px;
            margin-bottom: 20px;
        }

        .forgot-password:hover {
            color: var(--vermelho);
        }

        @@media (max-width: 768px) {
            .login-container {
                flex-direction: column;
                max-width: 450px;
            }
            .login-image-section {
                padding: 40px 30px;
            }
            .login-form-section {
                padding: 40px 30px;
            }
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-image-section">
            <div class="brand-logo-large">I</div>
            <h1 class="hero-title">Gestão Inteligente de <span>Validades</span>.</h1>
            <p class="hero-subtitle">Controle o vencimento dos seus produtos, reduza perdas e maximize seus lucros com o painel administrativo do IValid.</p>
        </div>

        <div class="login-form-section">
            <div class="login-header">
                <h2 class="login-title">Bem-vindo de volta</h2>
                <p class="login-subtitle">Insira suas credenciais para acessar o painel.</p>
            </div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert-sucesso">
                    <i class="fas fa-check-circle fs-5"></i>
                    <div>@TempData["Sucesso"]</div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-custom">
                    <i class="fas fa-exclamation-circle fs-5"></i>
                    <div>
                        @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled p-0 m-0" })
                    </div>
                </div>
            }

            <form asp-controller="Autenticacao" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                @if (!lojaSelecionada)
                {
                    <div class="mb-3">
                        <label asp-for="CodigoLoja" class="form-label-custom">Código da Loja</label>
                        <input asp-for="CodigoLoja" type="text" class="form-control form-control-custom" placeholder="Ex: mercadobompreco123" required autocomplete="off" />
                    </div>

                    <button type="submit" name="etapa" value="buscar" class="btn-login">
                        Continuar <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                }
                else
                {
                    <input type="hidden" asp-for="CodigoLoja" />

                    <div class="mb-3">
                        <label class="form-label-custom">Usuário</label>
                        <select asp-for="UsuarioChave" class="form-control form-control-custom" required>
                            <option value="">Selecione o usuário</option>
                            @foreach (var usuario in usuarios)
                            {
                                <option value="@usuario.Chave">@usuario.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label-custom">Senha</label>
                        <div style="position: relative;">
                            <input asp-for="Senha" type="password" id="campoSenha" class="form-control form-control-custom" placeholder="••••••••" required autocomplete="current-password" />
                            <button type="button" onclick="toggleSenha('campoSenha', this)" style="position: absolute; right: 10px; top: 12px; border: none; background: transparent; color: var(--text-muted-custom); cursor: pointer; outline: none;">
                                <i class="far fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <a asp-controller="Autenticacao" asp-action="EsqueciSenha" class="forgot-password">Esqueceu a senha?</a>

                    <button type="submit" name="etapa" value="entrar" class="btn-login">
                        Entrar no Painel <i class="fas fa-arrow-right ms-2"></i>
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Autenticacao" asp-action="Login" style="font-size:13px; color:var(--text-muted-custom); text-decoration:none;">
                            <i class="fas fa-arrow-left me-1"></i> Trocar de loja
                        </a>
                    </div>
                }
            </form>

            <div class="text-center mt-4" style="font-size: 14px; color: var(--text-muted-custom);">
                Ainda não tem conta? <a asp-controller="Autenticacao" asp-action="Registro" style="color: var(--vermelho); text-decoration: none; font-weight: 600;">Registre-se</a>
            </div>
        </div>
    </div>

    <script>
        function toggleSenha(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = "password";
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var alertas = document.querySelectorAll('.alert-custom, .alert-sucesso');
            alertas.forEach(function (alerta) {
                setTimeout(function () {
                    alerta.style.transition = 'opacity 0.4s ease';
                    alerta.style.opacity = '0';
                    setTimeout(function () {
                        alerta.remove();
                    }, 400);
                }, 4000);
            });
        });
    </script>
</body>
</html>
