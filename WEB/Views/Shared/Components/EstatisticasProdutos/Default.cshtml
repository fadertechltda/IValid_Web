@using WEB.ComponentesVisuais
@model ResumoEstatisticas

<div class="row row-cols-2 row-cols-xl-5 g-3 mb-4">
    <div class="col">
        <div class="stat-card secondary">
            <div class="stat-icon secondary"><i class="fas fa-skull-crossbones"></i></div>
            <div class="stat-value">@Model.TotalVencido</div>
            <div class="stat-label">⚫ Vencidos</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card danger">
            <div class="stat-icon danger"><i class="fas fa-fire"></i></div>
            <div class="stat-value">@Model.TotalVermelho</div>
            <div class="stat-label">🔴 Críticos</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card warning">
            <div class="stat-icon warning"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="stat-value">@Model.TotalAmarelo</div>
            <div class="stat-label">🟡 Em Atenção</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card success">
            <div class="stat-icon success"><i class="fas fa-check-circle"></i></div>
            <div class="stat-value">@Model.TotalVerde</div>
            <div class="stat-label">🟢 Na Validade</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card info">
            <div class="stat-icon info"><i class="fas fa-boxes"></i></div>
            <div class="stat-value">@Model.Total</div>
            <div class="stat-label">Total de Produtos</div>
        </div>
    </div>
</div>
