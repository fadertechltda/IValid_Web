@model string

@{
    var statusLower = (Model ?? string.Empty).ToLowerInvariant();

    string classeBadge = statusLower switch
    {
        "pagamento pix pendente" => "badge-amarelo",
        "em preparação"          => "badge-amarelo",
        "entregue"               => "badge-verde",
        _                        => "badge-vermelho"
    };

    string rotuloStatus = statusLower switch
    {
        "pagamento pix pendente" => "Pagamento Pendente",
        "em preparação"          => "Em Preparação",
        "entregue"               => "Entregue",
        _                        => Model ?? "Status Desconhecido"
    };
}

<span class="@classeBadge" style="text-transform:uppercase;">@rotuloStatus</span>
