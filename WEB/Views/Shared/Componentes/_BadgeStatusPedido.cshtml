@using DOMAIN.Model.Pedido
@model string

@{
    var statusCanonico = StatusPedidoUtil.Normalizar(Model);

    string classeBadge = statusCanonico switch
    {
        "PENDENTE" or "CONFIRMADO" or "SEPARADO" or "EM_ROTA" => "badge-amarelo",
        "FINALIZADO"                                          => "badge-verde",
        "CANCELADO"                                            => "badge-vermelho",
        _                                                      => "badge-vermelho"
    };

    string rotuloStatus = statusCanonico switch
    {
        "PENDENTE"   => "PENDENTE",
        "CONFIRMADO" => "CONFIRMADO",
        "SEPARADO"   => "SEPARADO",
        "EM_ROTA"    => "EM ROTA DE ENTREGA",
        "FINALIZADO" => "FINALIZADO",
        "CANCELADO"  => "CANCELADO",
        _            => (Model ?? "STATUS DESCONHECIDO").ToUpperInvariant()
    };
}

<span class="@classeBadge">@rotuloStatus</span>
